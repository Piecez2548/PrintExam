# ==========================================
# PrintExam Backend Environment Variables
# ==========================================

PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# เปิดเฉพาะเมื่อต้องสาธิตในเครื่อง ห้ามใช้ true บน production
ENABLE_DEMO_QUICK_LOGIN=false
# Demo-only: keep false by default. If enabled in production, read OTP only
# from the private Railway backend log console; never expose it to the browser.
ENABLE_PRIVATE_DEMO_OTP_LOG=false
FRONTEND_URL=http://localhost:5173

# Railway deployment/demo values (set only in the host environment):
# NODE_ENV=production
# FRONTEND_URL=https://<vercel-origin>
# PORT is provided by Railway.

# Optional upload root. Leave unset locally to keep using backend/uploads.
# Railway persistent Volume example: UPLOAD_DIR=/data/uploads

# Required only when seeding an empty PrintExam-Dev database.
# Keep the actual value local-only and never commit it.
SEED_DEFAULT_PASSWORD="replace-with-local-development-seed-password"

# ------------------------------------------
# Supabase PostgreSQL Database Configuration
# ------------------------------------------
# 1. DATABASE_URL: Connection Pooling (Port 6543, Transaction mode for high concurrency)
# Recommended for production and serverless / multiple simultaneous connections (NFR-1)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Connection (Port 5432, Session mode)
# Required by Prisma for running migrations and schema introspections
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------
# Supabase API & Storage Configuration (Optional)
# ------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="exam-documents"
