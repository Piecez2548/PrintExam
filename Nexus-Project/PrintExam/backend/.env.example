# ==========================================
# PrintExam Backend Environment Variables
# ==========================================

PORT=4000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# เปิดเฉพาะเมื่อต้องสาธิตในเครื่อง ห้ามใช้ true บน production
ENABLE_DEMO_QUICK_LOGIN=false
# สร้างข้อมูลตัวอย่างเฉพาะเครื่องพัฒนา ห้ามเปิดใน production
SEED_DEMO_DATA=false
FRONTEND_URL=http://localhost:5173
# Production ที่ frontend/backend คนละโดเมนใช้ none (ต้องเป็น HTTPS)
AUTH_COOKIE_SAME_SITE=lax

# OTP: local ใช้ console, demo บน Render ใช้ demo-log, ระบบจริงใช้ resend
OTP_DELIVERY_MODE=console
# เปิดเป็น true เฉพาะ mini project ที่ตั้ง OTP_DELIVERY_MODE=demo-log
ENABLE_DEMO_OTP_LOGGING=false
RESEND_API_KEY=
OTP_FROM_EMAIL=PrintExam <no-reply@example.ac.th>

# ------------------------------------------
# Supabase PostgreSQL Database Configuration
# ------------------------------------------
# 1. DATABASE_URL: Connection Pooling (Port 6543, Transaction mode for high concurrency)
# Recommended for production and serverless / multiple simultaneous connections (NFR-1)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL: Direct Connection (Port 5432, Session mode)
# Required by Prisma for running migrations and schema introspections
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------
# Supabase API & Storage Configuration (Optional)
# ------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET="exam-documents"
# local สำหรับทดลองในกลุ่ม, supabase สำหรับ deployment ที่ filesystem ไม่ถาวร
STORAGE_DRIVER=local
